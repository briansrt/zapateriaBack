            "description": "Created"
          },
          "409": {
            "description": "Conflict"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/zapatos/crearCompra": {
      "post": {
        "description": "Registra una nueva compra realizada por el usuario.",
        "parameters": [
          {
        "name": "body",
        "in": "body",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "userId": {
              "type": "string",
              "example": "68ac8fac891fff7162d7fa07"
            },
            "productos": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "productoId": {
                    "type": "string",
                    "example": "68afdf9dbfc5dab833538e91"
                  },
                  "cantidad": {
                    "type": "number",
                    "example": 2
                  },
                  "valor": {
                    "type": "number",
                    "example": 399000
                  }
                }
              }
            },
            "total": {
              "type": "number",
              "example": 798000
            }
          }
        }
      }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/zapatos/getCompras": {
      "post": {
        "description": "Obtiene las compras de un usuario específico.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "userId": {
                  "example": "68ac8fac891fff7162d7fa07"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/zapatos/getProductos": {
      "get": {
        "description": "Obtiene todos los productos disponibles en la zapatería.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/zapatos/getTodasCompras": {
      "get": {
        "description": "Obtiene todas las compras realizadas por todos los usuarios.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/zapatos/estadisticas": {
      "get": {
        "description": "Devuelve estadísticas generales de ventas y productos más vendidos.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
